# Copy this file to .env and fill in real values. Never commit .env itself.
# Keeping every secret here (not in code) is what makes moving this project
# to a different GitHub/Supabase/Vercel account later just a matter of
# swapping these values — see schema/001_init.sql for the portable schema.

# Supabase project (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (Project Settings -> Database), used for
# schema migrations and pg_dump backups
DATABASE_URL=

# Telegram alerts (Phase 6). Same values as the GitHub Actions secrets
# of the same name — needed locally too for any module that runs from
# this machine's Task Scheduler instead of GitHub Actions (currently
# dynamicair; see scripts/notify_telegram.py).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
