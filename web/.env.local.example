# Copy to .env.local for local dev. On Vercel, set these as Project
# Environment Variables instead (Settings > Environment Variables) —
# same names, same values as the repo root .env used by the scrapers.
# Not prefixed with NEXT_PUBLIC_ — this stays server-side only.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Part 2 (P2W InterPlus) access code — gates everything under /p2w.
# Never prefix with NEXT_PUBLIC_; read only by the login API route and
# middleware.ts, both server-side.
P2W_ACCESS_CODE=
